---
import { Image } from "astro:assets";
const { thumbnail, title, link, description } = Astro.props;
// Only same-site paths stay in the tab; protocol-relative (//) and other schemes are external.
const isExternal = !link.startsWith("/") || link.startsWith("//");
---

<div>
  <a
    href={link}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    aria-label={isExternal ? `${title} (opens in new tab)` : title}
  >
    <Image
      width={370}
      height={290}
      loading="lazy"
      src={thumbnail}
      alt={title}
      class="aspect-video object-cover rounded-lg"
    />
  </a>

  <h3 class="text-base font-medium pt-4 pb-2">{title}</h3>
  <p class="font-light text-sm text-muted line-clamp-3">
    {description}
  </p>
</div>
