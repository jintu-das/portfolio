---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import { SEO } from "astro-seo";
import "../styles/global.css";
import "@fontsource-variable/inter";

interface Props {
  title?: string;
  description?: string;
}

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const {
  title = "Jintu Das | Fullstack Developer & Freelance Software Engineer Based in Guwahati, Assam",
  description = "Jintu Das is a Guwahati-based freelance developer specializing in modern web development, UI/UX design, and scalable frontend architecture. Available for freelance gigs, remote roles, agency collaborations, and contract projects across Assam and beyond.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: new URL("/og.png", Astro.site).href,
          url: canonical,
        },
        optional: {
          description,
        },
      }}
      canonical={canonical}
      twitter={{
        creator: "@JintuDass",
      }}
    />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="antialiased text-midnight font-inter bg-[#fafafa]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="space-y-24 lg:space-y-40">
      <slot />
    </main>
    <Footer />
  </body>
</html>
